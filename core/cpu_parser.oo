// # oocpuinfo /proc/cpuinfo Stream Parser
//
// Logline: Key-value line parser extracting microarchitecture, hardware flags, and core topologies from /proc/cpuinfo.
//
// Setup: Pure string parsing engine operating without ambient filesystem authority.
//
// Beats:
//   1. Split multiline streams into individual attribute lines.
//   2. Parse colon-delimited key-value entries with whitespace trimming.
//   3. Extract microarchitecture model, frequency, and cache sizes.
//   4. Calculate socket count, cores per socket, and thread multiplier.

import "core/cpu_types.oo";

pub fn split_lines(text: String) -> List[String] {
    let mut lines: List[String] = list_new();
    let n: Int = chars_len(text);
    let mut start: Int = 0;
    let mut i: Int = 0;
    while i < n {
        if char_at(text, i) == "\n" {
            let line: String = str_slice(text, start, i);
            lines = list_push(lines, line);
            start = i + 1;
        }
        i = i + 1;
    }
    if start < n {
        lines = list_push(lines, str_slice(text, start, n));
    }
    return lines;
}

pub fn split_words(text: String) -> List[String] {
    let mut words: List[String] = list_new();
    let n: Int = chars_len(text);
    let mut start: Int = -1;
    let mut i: Int = 0;
    while i < n {
        let ch: Int = byte_at(text, i);
        if ch == 32 || ch == 9 || ch == 10 || ch == 13 {
            if start >= 0 {
                words = list_push(words, str_slice(text, start, i));
                start = -1;
            }
        } else {
            if start < 0 {
                start = i;
            }
        }
        i = i + 1;
    }
    if start >= 0 {
        words = list_push(words, str_slice(text, start, n));
    }
    return words;
}

fn parse_int_simple(s: String) -> Int {
    let mut val: Int = 0;
    let n: Int = chars_len(s);
    let mut has_digit: Bool = false;
    let mut i: Int = 0;
    while i < n {
        let b: Int = byte_at(s, i);
        if b >= 48 && b <= 57 {
            val = (val * 10) + (b - 48);
            has_digit = true;
        } else if has_digit {
            break;
        }
        i = i + 1;
    }
    return val;
}

pub fn parse_cpuinfo_stream(stream: String) -> CpuInfo {
    let mut info: CpuInfo = empty_cpu_info();
    let lines: List[String] = split_lines(stream);
    let num_lines: Int = list_len(lines);

    let mut proc_count: Int = 0;
    let mut max_socket: Int = 0;
    let mut cores_per_sock: Int = 1;
    let mut i: Int = 0;

    while i < num_lines {
        let line: String = list_get(lines, i);
        let colon_pos: Int = str_index_of(line, ":");
        if colon_pos > 0 {
            let key: String = str_trim(str_slice(line, 0, colon_pos));
            let val: String = str_trim(str_slice(line, colon_pos + 1, chars_len(line)));

            if key == "processor" {
                proc_count = proc_count + 1;
            } else if key == "vendor_id" && chars_len(info.vendor) == 0 || info.vendor == "Unknown" {
                info.vendor = val;
            } else if key == "model name" && (chars_len(info.model_name) == 0 || info.model_name == "Generic Processor") {
                info.model_name = val;
            } else if key == "cpu family" && info.family == 0 {
                info.family = parse_int_simple(val);
            } else if key == "model" && info.model == 0 {
                info.model = parse_int_simple(val);
            } else if key == "stepping" && info.stepping == 0 {
                info.stepping = parse_int_simple(val);
            } else if key == "microcode" && chars_len(info.microcode) == 0 {
                info.microcode = val;
            } else if key == "cpu MHz" && (info.mhz == "0.000" || chars_len(info.mhz) == 0) {
                info.mhz = val;
            } else if key == "cache size" && info.cache_kb == 0 {
                info.cache_kb = parse_int_simple(val);
            } else if key == "cpu cores" {
                cores_per_sock = parse_int_simple(val);
            } else if key == "physical id" {
                let sock_id: Int = parse_int_simple(val);
                if sock_id > max_socket {
                    max_socket = sock_id;
                }
            } else if key == "flags" && list_len(info.flags) == 0 {
                info.flags = split_words(val);
            } else if key == "bugs" && list_len(info.bugs) == 0 {
                info.bugs = split_words(val);
            }
        }
        i = i + 1;
    }

    info.logical_cpus = if proc_count > 0 { proc_count } else { 1 };
    info.sockets = max_socket + 1;
    info.cores = if cores_per_sock > 0 { cores_per_sock } else { 1 };
    let total_phys: Int = info.sockets * info.cores;
    info.threads = if total_phys > 0 { info.logical_cpus / total_phys } else { 1 };
    if info.threads < 1 { info.threads = 1; }

    return info;
}
