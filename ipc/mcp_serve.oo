// # oocpuinfo Streaming MCP Server
//
// Logline: JSON-RPC 2.0 stdio server exposing sovereign CPU architecture, topology, and vulnerability tools.
//
// Setup: Bridges standard input/output streaming JSON-RPC to the CpuInfo model using bounded capability tokens.
//
// Beats:
//   1. Handle MCP initialize handshake with server metadata.
//   2. Expose tools/list catalogue with six sovereign CPU inspection tools.
//   3. Dispatch tools/call for summary, topology, flags, cache, vulnerabilities, and demo.
//   4. Deliver streaming JSON-RPC responses over standard output.

import "core/cpu_types.oo";
import "core/cpu_sysfs.oo";
import "core/cpu_demo.oo";
import "render/cpu_json.oo";
import "render/cpu_view.oo";
import "render/cpu_theme.oo";
import "ipc/json_field.oo";

fn build_error(id: String, code: Int, msg: String) -> String {
    return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"error\":{\"code\":"
        + to_string(code) + ",\"message\":\"" + json_escape(msg) + "\"}}\n";
}

fn build_tool_result(id: String, text: String) -> String {
    return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":{\"content\":[{\"type\":\"text\",\"text\":\""
        + json_escape(text) + "\"}]}}\n";
}

pub fn render_mcp_init(id: String) -> String {
    return "{\"jsonrpc\":\"2.0\",\"id\":" + id
        + ",\"result\":{\"protocolVersion\":\"2024-11-05\",\"capabilities\":{\"tools\":{}},\"serverInfo\":{\"name\":\"oocpuinfo\",\"version\":\"0.2.0\"}}}\n";
}

pub fn render_mcp_tools_list(id: String) -> String {
    let mut out: String = "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":{\"tools\":[";
    out = out + "{\"name\":\"cpuinfo_summary\",\"description\":\"Return comprehensive CPU architecture and microarchitecture summary.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"demo\":{\"type\":\"boolean\"}}}},";
    out = out + "{\"name\":\"cpuinfo_topology\",\"description\":\"Inspect socket, core, thread counts and hierarchy.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"demo\":{\"type\":\"boolean\"}}}},";
    out = out + "{\"name\":\"cpuinfo_flags\",\"description\":\"List processor instruction set extensions with optional substring query.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"filter\":{\"type\":\"string\"},\"demo\":{\"type\":\"boolean\"}}}},";
    out = out + "{\"name\":\"cpuinfo_vulnerabilities\",\"description\":\"Audit hardware vulnerabilities and kernel mitigation statuses.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"demo\":{\"type\":\"boolean\"}}}},";
    out = out + "{\"name\":\"cpuinfo_cache\",\"description\":\"Inspect processor L1/L2/L3 cache sizing.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"demo\":{\"type\":\"boolean\"}}}},";
    out = out + "{\"name\":\"cpuinfo_demo\",\"description\":\"Return synthetic 192-core AMD EPYC server fixture telemetry.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{}}}";
    out = out + "]}}\n";
    return out;
}

pub fn handle_mcp_call(
    fr: &FsReadCap,
    id: String,
    tool_name: String,
    req: String
) -> String {
    let use_demo: Bool = extract_json_bool(req, "demo", false);
    let info: CpuInfo = if use_demo || tool_name == "cpuinfo_demo" {
        build_demo_cpu_info()
    } else {
        load_host_cpu_info(fr)
    };

    if tool_name == "cpuinfo_summary" {
        return build_tool_result(id, cpu_to_json(info));
    }
    if tool_name == "cpuinfo_topology" {
        return build_tool_result(id, topology_to_json(info));
    }
    if tool_name == "cpuinfo_flags" {
        let filter_str: String = extract_json_str(req, "filter");
        if chars_len(filter_str) > 0 {
            let mono: ThemePalette = get_theme("monochrome");
            let filtered_view: String = render_flags(info, filter_str, mono);
            return build_tool_result(id, filtered_view);
        }
        return build_tool_result(id, flags_to_json(info));
    }
    if tool_name == "cpuinfo_vulnerabilities" {
        return build_tool_result(id, vulns_to_json(info));
    }
    if tool_name == "cpuinfo_cache" {
        let out: String = "{\"cache_size_kb\":" + to_string(info.cache_kb) + "}";
        return build_tool_result(id, out);
    }
    if tool_name == "cpuinfo_demo" {
        return build_tool_result(id, cpu_to_json(info));
    }

    return build_error(id, -32601, "Unknown tool: " + tool_name);
}

pub fn handle_mcp_message(fr: &FsReadCap, req: String) -> String {
    let id_str: String = extract_json_str(req, "id");
    let id: String = if chars_len(id_str) > 0 { "\"" + id_str + "\"" } else { "1" };
    let method: String = extract_json_str(req, "method");

    if method == "initialize" {
        return render_mcp_init(id);
    }
    if method == "notifications/initialized" {
        return "";
    }
    if method == "tools/list" {
        return render_mcp_tools_list(id);
    }
    if method == "tools/call" {
        let tool_name: String = extract_json_str(req, "name");
        return handle_mcp_call(fr, id, tool_name, req);
    }
    if method == "shutdown" {
        return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":null}\n";
    }
    return build_error(id, -32601, "Method not found: " + method);
}

pub fn run_mcp_server(fr: &FsReadCap) {
    let mut buf: String = "";
    let mut running: Bool = true;
    while running {
        let r: Result[String, String] = oo_read_stdin_chunk(fr, 4096);
        if !r.is_ok() {
            running = false;
        } else {
            let chunk: String = match r { Ok(s) => s, Err(_) => "" };
            if chars_len(chunk) == 0 {
                running = false;
            } else {
                buf = buf + chunk;
                let mut nl_pos: Int = str_index_of(buf, "\n");
                while nl_pos >= 0 {
                    let line: String = str_slice(buf, 0, nl_pos);
                    buf = str_slice(buf, nl_pos + 1, chars_len(buf));
                    let trimmed: String = str_trim(line);
                    if chars_len(trimmed) > 0 {
                        let resp: String = handle_mcp_message(fr, trimmed);
                        if chars_len(resp) > 0 {
                            print(resp);
                        }
                    }
                    nl_pos = str_index_of(buf, "\n");
                }
            }
        }
    }
}
