// # oocpuinfo CLI Options Parser
//
// Logline: Robust argument parser mapping POSIX and GNU lscpu style flags to CpuConfig.
//
// Setup: Parses raw command line arguments into structured configuration records.
//
// Beats:
//   1. Declare ParsedCpu container holding CpuConfig and dispatch flags.
//   2. Process inspection flags (-t topology, -f flags, -c cache, -u vulnerabilities, -a all).
//   3. Extract demo fixture triggers, filter queries, themes, and JSON switches.
//   4. Deliver standard usage help text.

import "core/cpu_types.oo";

type ParsedCpu = struct {
    config: CpuConfig,
    show_help: Bool,
    show_version: Bool,
    run_mcp: Bool,
    parse_error: String
};

pub fn parse_cpu_args(args: List[String]) -> ParsedCpu {
    let mut cfg: CpuConfig = default_cpu_config();
    let mut show_help: Bool = false;
    let mut show_version: Bool = false;
    let mut run_mcp: Bool = false;
    let mut parse_error: String = "";

    let num_args: Int = list_len(args);
    let mut i: Int = 0;
    while i < num_args {
        let arg: String = list_get(args, i);
        if arg == "-h" || arg == "--help" {
            show_help = true;
        } else if arg == "-v" || arg == "--version" {
            show_version = true;
        } else if arg == "--mcp" {
            run_mcp = true;
        } else if arg == "-t" || arg == "--topology" {
            cfg.show_topology = true;
        } else if arg == "-f" || arg == "--flags" {
            cfg.show_flags = true;
        } else if arg == "-c" || arg == "--cache" {
            cfg.show_cache = true;
        } else if arg == "-u" || arg == "--vulns" || arg == "--vulnerabilities" {
            cfg.show_vulns = true;
        } else if arg == "-a" || arg == "--all" {
            cfg.show_topology = true;
            cfg.show_flags = true;
            cfg.show_cache = true;
            cfg.show_vulns = true;
        } else if arg == "-d" || arg == "--demo" {
            cfg.demo_mode = true;
        } else if arg == "-j" || arg == "--json" {
            cfg.json_output = true;
        } else if arg == "--filter" && i + 1 < num_args {
            i = i + 1;
            cfg.flag_filter = list_get(args, i);
        } else if arg == "--theme" && i + 1 < num_args {
            i = i + 1;
            cfg.theme = list_get(args, i);
        } else {
            parse_error = "Unknown option: " + arg;
        }
        i = i + 1;
    }

    return ParsedCpu {
        config: cfg,
        show_help: show_help,
        show_version: show_version,
        run_mcp: run_mcp,
        parse_error: parse_error
    };
}

pub fn render_cpu_help() -> String {
    let mut out: String = "Usage: oocpuinfo [OPTIONS]\n\n";
    out = out + "Hardware CPU topology & instruction set inspection engine in pure native openOODA.\n\n";
    out = out + "Options:\n";
    out = out + "  -t, --topology         Display socket, core, and thread topology hierarchy\n";
    out = out + "  -f, --flags            Display processor instruction set flags\n";
    out = out + "  -c, --cache            Display processor cache geometry\n";
    out = out + "  -u, --vulns            Display hardware vulnerability mitigations\n";
    out = out + "  -a, --all              Display all sections (summary, topology, flags, vulns)\n";
    out = out + "      --filter <QUERY>   Filter instruction set flags by query substring\n";
    out = out + "  -d, --demo             Run in deterministic synthetic demo mode\n";
    out = out + "  -j, --json             Output structured JSON\n";
    out = out + "      --theme <THEME>    Select terminal color theme (ember, ocean, matrix, cyber, monochrome)\n";
    out = out + "      --mcp              Run streaming MCP JSON-RPC 2.0 server on stdio\n";
    out = out + "  -h, --help             Show this help message and exit\n";
    out = out + "  -v, --version          Show version information and exit\n";
    return out;
}
