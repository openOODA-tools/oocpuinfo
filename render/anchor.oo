// # oocpuinfo Render Subsystem Unit Tests
//
// Logline: Verification anchors for terminal visual rendering and JSON serialization.
//
// Setup: Executes themed render passes and JSON structure validations against synthetic CPU models.
//
// Beats:
//   1. Verify theme palette resolution and fallback behavior.
//   2. Verify human-readable summary card and topology formatting.
//   3. Verify instruction flag rendering with filter queries.
//   4. Verify vulnerability audit rendering and JSON serialization.

import "core/cpu_types.oo";
import "core/cpu_demo.oo";
import "render/cpu_theme.oo";
import "render/cpu_view.oo";
import "render/cpu_json.oo";

pub fn test_themes() -> Bool {
    let mono: ThemePalette = get_theme("monochrome");
    if mono.bold != "" {
        return false;
    }
    let def_th: ThemePalette = get_theme("default");
    if chars_len(def_th.bold) == 0 {
        return false;
    }
    return true;
}

pub fn test_render_views() -> Bool {
    let mono: ThemePalette = get_theme("monochrome");
    let info: CpuInfo = build_demo_cpu_info();

    let summary: String = render_cpu_summary(info, mono);
    if !str_contains(summary, "EPYC 9654") {
        return false;
    }
    if !str_contains(summary, "384 logical CPUs") {
        return false;
    }

    let topo: String = render_topology(info, mono);
    if !str_contains(topo, "Sockets:             2") {
        return false;
    }
    if !str_contains(topo, "Cores per Socket:    96") {
        return false;
    }

    let flags_str: String = render_flags(info, "avx512", mono);
    if !str_contains(flags_str, "avx512f") {
        return false;
    }

    let vulns_str: String = render_vulnerabilities(info, mono);
    if !str_contains(vulns_str, "Spectre v1") {
        return false;
    }
    if !str_contains(vulns_str, "[MITIGATED]") {
        return false;
    }

    return true;
}

pub fn test_render_json() -> Bool {
    let info: CpuInfo = build_demo_cpu_info();

    let json_str: String = cpu_to_json(info);
    if !str_contains(json_str, "\"vendor\": \"AuthenticAMD\"") {
        return false;
    }
    if !str_contains(json_str, "\"logical_cpus\": 384") {
        return false;
    }

    let topo_json: String = topology_to_json(info);
    if !str_contains(topo_json, "\"total_physical_cores\": 192") {
        return false;
    }

    let flags_json: String = flags_to_json(info);
    if !str_contains(flags_json, "\"count\":") {
        return false;
    }

    let v_json: String = vulns_to_json(info);
    if !str_contains(v_json, "\"Spectre v1\"") {
        return false;
    }

    return true;
}

pub fn run_render_tests() -> Bool {
    if !test_themes() {
        return false;
    }
    if !test_render_views() {
        return false;
    }
    if !test_render_json() {
        return false;
    }
    return true;
}
